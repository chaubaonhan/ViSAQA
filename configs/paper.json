{
  "models": {
    "vit5": "VietAI/vit5-base",
    "bartpho": "vinai/bartpho-syllable-base",
    "mbart": "facebook/mbart-large-50-many-to-many-mmt",
    "mt5-base": "google/mt5-base",
    "mt5-small": "google/mt5-small"
  },
  "protocols": ["topic", "random"],
  "seeds": [22, 42, 202],
  "training": {
    "epochs": 5,
    "learning_rate": 0.00003,
    "effective_batch_size": 256,
    "per_device_batch_size": 8,
    "eval_batch_size": 8,
    "max_input_length": 1024,
    "max_target_length": 256,
    "optimizer": "adamw_torch",
    "weight_decay": 0.0,
    "warmup_ratio": 0.0,
    "scheduler": "linear",
    "max_grad_norm": 1.0,
    "precision": "fp32",
    "gradient_checkpointing": false,
    "checkpoint_selection": "last_epoch"
  },
  "generation": {"max_length": 256, "num_beams": 1, "do_sample": false},
  "retrieval": {
    "encoder": "intfloat/multilingual-e5-base",
    "reranker": "BAAI/bge-reranker-v2-m3",
    "candidate_k": 20,
    "top_k": 3,
    "rrf_k": 60,
    "encoder_max_length": 512,
    "reranker_max_length": 1024,
    "batch_size": 16,
    "bm25_k1": 1.5,
    "bm25_b": 0.75
  },
  "chunking": {"size": 512, "overlap": 80, "tokenizer": "intfloat/multilingual-e5-base"},
  "prompt": {"q_only": "Câu hỏi: {question}", "context": "Câu hỏi: {question}\nNgữ cảnh: {context}"},
  "evaluation": {"bertscore_model": "xlm-roberta-large", "bertscore_layers": 17, "seed_sd_ddof": 1}
}
